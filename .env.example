# Copy this file to .env (gitignored) and fill in real phrases.
# Each PACTO_DEMO_SEED_N is assigned to client N.
# Clients without a seed (or beyond the last one) start on the welcome screen.

PACTO_APP_REMOTE=https://github.com/covenant-gov/pacto-app.git

PACTO_DEMO_SEED_1="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
PACTO_DEMO_SEED_2="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
# PACTO_DEMO_SEED_3="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# Optional. Dev autologin PIN for seeded clients (default 123456).
# PACTO_DEMO_PIN=123456
